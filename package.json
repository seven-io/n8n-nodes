{
  "name": "n8n-nodes-seven",
  "version": "0.1.0",
  "description": "seven.io nodes for n8n",
  "keywords": [
    "n8n-community-node-package"
  ],
  "license": "MIT",
  "homepage": "https://www.seven.io",
  "author": {
    "name": "seven communications GmbH & Co. KG",
    "email": "support@seven.io"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seven-io/n8n-nodes.git"
  },
  "engines": {
    "node": ">=20.15"
  },
  "packageManager": "pnpm@11.1.2",
  "main": "index.js",
  "scripts": {
    "build": "rimraf dist && tsc && gulp build:icons",
    "dev": "tsc --watch",
    "format": "prettier nodes credentials --write",
    "lint": "eslint nodes credentials package.json",
    "lintfix": "eslint nodes credentials package.json --fix",
    "lint:prepublish": "eslint -c .eslintrc.prepublish.js nodes credentials package.json",
    "test": "jest",
    "prepublishOnly": "pnpm build && pnpm lint:prepublish"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "credentials": [
      "dist/credentials/SevenApi.credentials.js",
      "dist/credentials/SevenOAuth2Api.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Seven/Seven.node.js",
      "dist/nodes/Seven/SevenTrigger.node.js"
    ]
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@typescript-eslint/parser": "~8.32.0",
    "eslint": "^8.57.0",
    "eslint-plugin-n8n-nodes-base": "^1.16.3",
    "gulp": "^5.0.0",
    "jest": "^29.7.0",
    "n8n-workflow": "*",
    "prettier": "^3.5.3",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.3.2",
    "typescript": "^5.8.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
